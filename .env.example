POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
OPENALEX_MAILTO=
OPENALEX_API_KEY=
# Days re-fetched on every run to catch works OpenAlex indexes late (0 disables)
INGEST_LOOKBACK_DAYS=7
# Weekly refresh (refresh_openalex DAG, --refresh) re-fetches the days older than the lookback, up to this many back
INGEST_REFRESH_DAYS=60
# pipeline_health DAG: fail when the latest gold day / the last successful ingest is older than this
HEALTH_MAX_GOLD_LAG_DAYS=3
HEALTH_MAX_INGEST_AGE_HOURS=26

# Airflow: secret its components use to sign tokens to each other; any long random string,
# e.g. `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`.
# POSTGRES_USER / POSTGRES_PASSWORD go into its DB URL, so keep them URL-safe.
AIRFLOW_JWT_SECRET=
